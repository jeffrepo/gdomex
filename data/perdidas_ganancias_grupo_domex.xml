            <!-- RESULTADO OPERATIVO: misma formula del informe estandar -->
            <record id="gdomex_pnl_line_operating_income" model="account.report.line">
                <field name="name">Resultado operativo (o pérdida)</field>
                <field name="code">INC</field>
                <field name="sequence">500</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_operating_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance - COS.balance - EXP.balance</field>
                    </record>
                </field>
            </record>

