<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <!--
        Variante por sucursal basada en la estructura del profit_and_loss.xml
        suministrado para Odoo 19.

        El total de Ingreso incluye los diarios de tipo Ventas. Su desglose se
        clasifica dinamicamente por el nombre del diario; "Facturas de cliente"
        es la unica excepcion fija y pertenece a DOMEX.

        Mapeo analitico tomado del informe de costo de ventas:
        COSTO:    DOMEX 230, ALMEX 229, APLYTEK 231, ARMADILLO 232, ARMADILLO-Z 233.
        SUCURSAL: DOMEX 58,  ALMEX 57,  APLYTEK 191, ARMADILLO 59,  ARMADILLO-Z 157.
    -->
    <record id="gdomex_report_profit_and_loss" model="account.report">
        <field name="name">Pérdidas y ganancias Grupo Domex</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="sequence">20</field>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_budgets" eval="True"/>
        <field name="allow_account_audit_status_on_lines" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>

        <field name="column_ids">
            <record id="gdomex_report_profit_and_loss_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>

        <field name="line_ids">
            <!-- INGRESO -->
            <record id="gdomex_pnl_line_revenue" model="account.report.line">
                <field name="name">Ingreso</field>
                <field name="code">REV</field>
                <field name="sequence">100</field>
                <field name="hierarchy_level">1</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_revenue_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="gdomex_pnl_line_revenue_domex" model="account.report.line">
                        <field name="name">DOMEX</field>
                        <field name="code">REV_DOMEX</field>
                        <field name="sequence">101</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_revenue_domex_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="['&amp;', '&amp;', ('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale'), '|', '|', ('journal_id.name', 'ilike', 'DOMEX'), ('journal_id.name', 'ilike', 'DMX'), ('journal_id.name', '=ilike', 'Facturas de cliente')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="gdomex_pnl_line_revenue_almex" model="account.report.line">
                        <field name="name">ALMEX</field>
                        <field name="code">REV_ALMEX</field>
                        <field name="sequence">102</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_revenue_almex_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="['&amp;', '&amp;', ('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale'), '|', ('journal_id.name', 'ilike', 'ALMEX'), ('journal_id.name', 'ilike', 'ALX')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="gdomex_pnl_line_revenue_aplytek" model="account.report.line">
                        <field name="name">APLYTEK</field>
                        <field name="code">REV_APLYTEK</field>
                        <field name="sequence">103</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_revenue_aplytek_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="['&amp;', '&amp;', ('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale'), '|', ('journal_id.name', 'ilike', 'APLYTEK'), ('journal_id.name', 'ilike', 'APL')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="gdomex_pnl_line_revenue_armadillo" model="account.report.line">
                        <field name="name">ARMADILLO</field>
                        <field name="code">REV_ARMADILLO</field>
                        <field name="sequence">104</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_revenue_armadillo_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale'), ('journal_id.name', 'ilike', 'ARMADILLO'), ('journal_id.name', 'not ilike', 'ARMADILLO-Z'), ('journal_id.name', 'not ilike', 'ARMADILLO Z')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="gdomex_pnl_line_revenue_armadillo_z" model="account.report.line">
                        <field name="name">ARMADILLO-Z</field>
                        <field name="code">REV_ARMADILLO_Z</field>
                        <field name="sequence">105</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_revenue_armadillo_z_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="['&amp;', '&amp;', ('account_id.account_type', '=', 'income'), ('journal_id.type', '=', 'sale'), '|', '|', ('journal_id.name', 'ilike', 'ARMADILLO-Z'), ('journal_id.name', 'ilike', 'ARMADILLO Z'), ('journal_id.name', 'ilike', 'ARM-Z')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>

            <!-- COSTE DE INGRESOS -->
            <record id="gdomex_pnl_line_cost_of_revenue" model="account.report.line">
                <field name="name">Coste de ingresos</field>
                <field name="code">COS</field>
                <field name="sequence">200</field>
                <field name="hierarchy_level">1</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_cost_of_revenue_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost'), ('analytic_distribution', 'in', ['230', '229', '231', '232', '233'])]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="gdomex_pnl_line_cost_of_revenue_domex" model="account.report.line">
