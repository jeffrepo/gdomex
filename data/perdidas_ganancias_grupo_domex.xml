                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                    <record id="gdomex_pnl_line_cost_of_revenue_aplytek" model="account.report.line">
                        <field name="name">APLYTEK</field>
                        <field name="code">COS_APLYTEK</field>
                        <field name="sequence">203</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_cost_of_revenue_aplytek_balance" model="account.report.expression">
