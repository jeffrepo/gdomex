                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="gdomex_pnl_line_other_expenses_armadillo_z_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id', 'in', [4852, 4280, 4854]), ('analytic_distribution', 'in', ['157'])]"/>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                </field>
            </record>

            <!-- RESULTADO NETO: misma formula del informe estandar -->
            <record id="gdomex_pnl_line_net_profit" model="account.report.line">
                <field name="name">Resultado neto</field>
                <field name="code">NEP</field>
                <field name="sequence">800</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_net_profit_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance + OIN.balance - COS.balance - EXP.balance - OEXP.balance</field>
                    </record>
                </field>
            </record>

            <!-- DISTRIBUCIONES Y RETIROS: sin cambios -->
            <record id="gdomex_pnl_line_allocations_withdrawals" model="account.report.line">
                <field name="name">Distribuciones y retiros</field>
                <field name="code">ALLOC</field>
                <field name="sequence">900</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_allocations_withdrawals_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'equity_unaffected')]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>

            <!-- RESULTADO DESPUES DE DISTRIBUCIONES: sin cambios -->
            <record id="gdomex_pnl_line_net_profit_after_allocations" model="account.report.line">
                <field name="name">Resultado neto después de distribuciones y retiros</field>
                <field name="code">NEPAL</field>
                <field name="sequence">1000</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_net_profit_after_allocations_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NEP.balance - ALLOC.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="gdomex_action_profit_and_loss" model="ir.actions.client">
        <field name="name">Pérdidas y ganancias Grupo Domex</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('gdomex_report_profit_and_loss')}"/>
    </record>

    <menuitem
        id="gdomex_menu_profit_and_loss"
        name="Pérdidas y ganancias Grupo Domex"
        parent="account.menu_finance_reports"
        action="gdomex_action_profit_and_loss"
        sequence="96"/>
</odoo>
