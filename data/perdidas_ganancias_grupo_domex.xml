                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost'), ('analytic_distribution', 'in', ['233'])]"/>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                </field>
            </record>

            <!-- RESULTADO BRUTO: misma formula del informe estandar -->
            <record id="gdomex_pnl_line_gross_profit" model="account.report.line">
                <field name="name">Resultado bruto</field>
                <field name="code">GRP</field>
                <field name="sequence">300</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_gross_profit_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance - COS.balance</field>
                    </record>
                </field>
            </record>

            <!-- GASTOS -->
            <record id="gdomex_pnl_line_expenses" model="account.report.line">
                <field name="name">Gastos</field>
                <field name="code">EXP</field>
                <field name="sequence">400</field>
                <field name="hierarchy_level">1</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="gdomex_pnl_line_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense'), ('account_id', 'not in', [4852, 4280, 4854]), ('analytic_distribution', 'in', ['58', '57', '191', '59', '157'])]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
