<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_traslado_interno" model="report.paperformat">
        <field name="name">Traslado interno - Carta</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="css_margins" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!-- Keep styles in the document and footer, which Odoo renders separately. -->
    <template id="report_traslado_interno_styles">
        <style>
            body.o_body_html, body.o_body_pdf {
                margin: 0 !important;
                padding: 0 !important;
                width: 100%;
                max-width: none;
            }
            .gdomex_traslado_interno_header,
            .gdomex_traslado_interno_footer {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .gdomex_traslado_interno {
                padding: 0;
            }
            .gdomex_traslado_interno_content {
                padding: 4mm 14.5mm 0;
            }
            .gdomex_traslado_interno_header {
                page-break-inside: avoid;
                page-break-after: avoid;
            }
            .gdomex_traslado_interno h2 {
                color: #222247;
            }
            .gdomex_traslado_interno .o_main_table thead {
                color: #222247;
                border-bottom: 1px solid #e65b1c;
            }
        </style>
    </template>

    <template id="report_traslado_interno_header">
        <!-- Deliberately no "header" class: the letterhead stays inside the PDF body. -->
        <div class="gdomex_traslado_interno_header"
             style="position: relative; min-height: 34mm; padding: 0; font-family: Arial, sans-serif; color: #222247;">
            <t t-call="gdomex.report_traslado_interno_styles"/>
            <div style="position: absolute; top: 0; right: 0; width: 59mm; height: 5.6mm; background-color: #e65b1c;">
                <div style="width: 23.6mm; height: 5.6mm; background-color: #222247;"/>
            </div>
            <!-- Keep the logo and title in normal flow so their height is reserved in HTML and PDF. -->
            <div style="padding: 6mm 14.5mm 0;">
                <table class="table-borderless" role="presentation"
                       style="width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0;">
                    <tr>
                        <td style="width: 59mm; padding: 0; border: 0; vertical-align: middle;">
                            <img src="/gdomex/static/src/img/grupo_domex_nuevo.png" alt="Grupo Domex"
                                 style="display: block; width: 52mm; height: auto; margin-left: 3.5mm;"/>
                            <div style="margin-top: 0.8mm; height: 2.8mm; background-color: #e65b1c;">
                                <div style="width: 23.6mm; height: 2.8mm; background-color: #222247;"/>
                            </div>
                        </td>
                        <td style="width: 9mm; padding: 0; border: 0; border-right: 0.35mm solid #e65b1c;"/>
                        <td style="padding: 0 0 0 4mm; border: 0; vertical-align: middle; font-size: 11.5pt; font-weight: bold; line-height: 1.2;">
                            <div style="color: #e65b1c; margin-bottom: 0.6mm; white-space: nowrap;">TRASLADO INTERNO</div>
                            <div>Departamento de<br/>Bodega y Almacén</div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="report_traslado_interno_layout">
        <div class="page gdomex_traslado_interno_document">
            <t t-call="gdomex.report_traslado_interno_header"/>
            <t t-out="0"/>
        </div>
    </template>

    <template id="report_traslado_interno_footer">
        <div class="footer gdomex_traslado_interno_footer" style="position: relative; height: 12mm; padding: 0;">
            <t t-call="gdomex.report_traslado_interno_styles"/>
            <div style="position: absolute; bottom: 0; left: 0; width: 59mm; height: 5.6mm; background-color: #e65b1c;">
                <div style="width: 23.6mm; height: 5.6mm; background-color: #222247;"/>
            </div>
        </div>
    </template>

    <!-- Primary inheritance creates a separate report, leaving Picking Operations unchanged. -->
    <template id="report_traslado_interno" inherit_id="stock.report_picking" primary="True">
        <xpath expr="//t[@t-call='web.report_layout']" position="attributes">
            <attribute name="t-call">web.html_container</attribute>
        </xpath>
        <xpath expr="//div[hasclass('article')]" position="before">
            <t t-set="data_report_margin_top" t-value="0"/>
            <t t-set="data_report_header_spacing" t-value="0"/>
        </xpath>
        <xpath expr="//div[hasclass('article')]" position="after">
            <t t-call="gdomex.report_traslado_interno_footer"/>
        </xpath>
        <xpath expr="//div[hasclass('article')]" position="attributes">
            <attribute name="class">article gdomex_traslado_interno</attribute>
        </xpath>
        <xpath expr="//div[hasclass('article')]" position="inside">
            <t t-call="gdomex.report_traslado_interno_styles"/>
        </xpath>
        <!-- Wrap each picking in our own layout, keeping all native operations in $0. -->
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">gdomex_traslado_interno_content</attribute>
        </xpath>
        <xpath expr="//div[hasclass('gdomex_traslado_interno_content')]" position="replace">
            <t t-call="gdomex.report_traslado_interno_layout">$0</t>
        </xpath>
        <xpath expr="//h3[@t-field='o.picking_type_id.code']" position="replace"/>
        <xpath expr="//div[@name='right_box']" position="replace"/>
        <xpath expr="//h2[@t-field='o.name']/parent::div" position="attributes">
            <attribute name="class">col-12</attribute>
        </xpath>
        <!-- Hide the complete product/lot barcode column, including its heading and cells. -->
        <xpath expr="//t[@t-set='barcode_col_exists']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//span[@t-out='line.lot_id.name']" position="attributes">
            <attribute name="t-out">line.lot_id.name or line.lot_name</attribute>
        </xpath>
        <!-- Package identifiers remain readable in both reserved and completed transfers. -->
        <xpath expr="//tr[@t-as='package']//div[@t-field='package.name']" position="replace">
            <span t-field="package.name"/>
        </xpath>
        <xpath expr="//tr[@t-as='package_history']//div[@t-field='package.name']" position="replace">
            <span t-field="package.name"/>
        </xpath>
    </template>

    <record id="action_report_traslado_interno" model="ir.actions.report">
        <field name="name">Traslado interno</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gdomex.report_traslado_interno</field>
        <field name="report_file">gdomex.report_traslado_interno</field>
        <field name="print_report_name">'Traslado interno - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_traslado_interno"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
