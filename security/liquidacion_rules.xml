<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conditional global rules prevent other groups (e.g. Sales) from
         widening this profile through the OR of group-specific rules.
         Existing accounting users retain their usual access. -->
    <record id="rule_liquidacion_company" model="ir.rule">
        <field name="name">Liquidaciones: compañías permitidas</field>
        <field name="model_id" ref="account_gt.model_account_gt_liquidacion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liquidacion_vendor_bill" model="ir.rule">
        <field name="name">Liquidaciones: sólo facturas de proveedor vinculadas</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('move_type', '=', 'in_invoice'), ('liquidacion_id', '!=', False), ('liquidacion_id.company_id', 'in', company_ids)] if user.has_group('gdomex.group_liquidacion_user') and not user.has_group('account.group_account_invoice') else [(1, '=', 1)]</field>
    </record>
    <record id="rule_liquidacion_vendor_bill_line" model="ir.rule">
        <field name="name">Liquidaciones: apuntes de sus facturas de proveedor</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.move_type', '=', 'in_invoice'), ('move_id.liquidacion_id', '!=', False), ('move_id.liquidacion_id.company_id', 'in', company_ids)] if user.has_group('gdomex.group_liquidacion_user') and not user.has_group('account.group_account_invoice') else [(1, '=', 1)]</field>
    </record>
    <!-- Odoo intersects global rules with the union of applicable group rules.
         Sales users have group rules limited to customer invoices. The global
         limits above cannot grant vendor-bill access on their own: this group
         must also allow its bills and lines inside that union. -->
    <record id="rule_liquidacion_vendor_bill_group" model="ir.rule">
        <field name="name">Liquidaciones: acceso a sus facturas de proveedor</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[Command.link(ref('gdomex.group_liquidacion_user'))]"/>
        <field name="domain_force">[('move_type', '=', 'in_invoice'), ('liquidacion_id', '!=', False), ('liquidacion_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liquidacion_vendor_bill_line_group" model="ir.rule">
        <field name="name">Liquidaciones: acceso a los apuntes de sus facturas</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[Command.link(ref('gdomex.group_liquidacion_user'))]"/>
        <field name="domain_force">[('move_id.move_type', '=', 'in_invoice'), ('move_id.liquidacion_id', '!=', False), ('move_id.liquidacion_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liquidacion_payment" model="ir.rule">
        <field name="name">Liquidaciones: consulta de pagos vinculados</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[('liquidacion_id', '!=', False), ('liquidacion_id.company_id', 'in', company_ids)] if user.has_group('gdomex.group_liquidacion_user') and not user.has_group('account.group_account_invoice') else [(1, '=', 1)]</field>
    </record>
</odoo>
