<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grupo_fabribar_desde_proyectos" model="res.groups">
        <field name="name">Fabricar desde proyectos</field>
    </record>
    <record id="privilege_liquidaciones" model="res.groups.privilege">
        <field name="name">Liquidaciones</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_liquidacion_user" model="res.groups">
        <field name="name">Gestionar liquidaciones y facturas de proveedor</field>
        <field name="privilege_id" ref="privilege_liquidaciones"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Acceso independiente a liquidaciones. Permite crear y validar sus facturas de proveedor, sin conceder los grupos de Contabilidad o Facturación.</field>
    </record>
</odoo>
